# Server
PORT=4000
NODE_ENV=development
# Comma-separated exact browser origins; production example: https://app.example.com
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=0

# Optional shared cookie domain for app.example.com and api.example.com.
# Leave empty for localhost. Use COOKIE_SAME_SITE=none only with HTTPS.
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/musicroom?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5433/musicroom?schema=public

# Redis (Socket.IO adapter + room state cache)
REDIS_URL=redis://localhost:6379

# Auth
# Replace both local placeholders with distinct random secrets before deployment.
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Object storage (S3-compatible; MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-local-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-minio-secret-key
S3_BUCKET=music-room
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/music-room

# Uploads
MAX_AUDIO_FILE_SIZE_MB=50
MAX_ARTWORK_FILE_SIZE_MB=5

# Google OAuth (same web client ID used by the web app; no client secret is needed)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Gmail SMTP (use a Google App Password, not your Gmail account password)
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# Public web origin used to build password reset and email verification links
WEB_APP_URL=http://localhost:3000
